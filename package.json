{
  "name": "oncewarn",
  "version": "0.1.0",
  "description": "Warn when something that should be rare runs too often — init called in a loop, duplicate listeners, rerender requests.",
  "author": {
    "name": "Eesa Zakariyya",
    "email": "eesaard@gmail.com",
    "url": "https://github.com/igu1"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "example": "tsx examples/example.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "warn",
    "once",
    "debug",
    "devtools",
    "counter",
    "duplicate",
    "listeners",
    "loop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igu1/oncewarn.git"
  },
  "bugs": {
    "url": "https://github.com/igu1/oncewarn/issues"
  },
  "homepage": "https://github.com/igu1/oncewarn#readme",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
